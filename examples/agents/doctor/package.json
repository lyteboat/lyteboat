{
  "name": "@lyteboat/agent-doctor",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "The clinical trial screening assistant of the doctor workbench: its persona and fourteen tools, whose execution and digests stay in the doctor service. Each tool posts its call to the doctor service's internal tool endpoint (DOCTOR_CLINICAL_URL, bearer DOCTOR_AGENT_SECRET) on behalf of the doctor the request context names (context.actor), with the page the doctor is looking at (context.page); UI intents and jump cards come back as A2UI cards. Patients appear only as 患者#<id>",
  "type": "module",
  "exports": {
    "./agent": {
      "@lyteboat/source": "./src/agent.ts",
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    }
  },
  "files": [
    "lib",
    "agent.yml",
    "assets"
  ],
  "dependencies": {
    "@lyteboat/agent-definition": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@lyteboat/a2ui": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@lyteboat/a2ui": "workspace:*",
    "@lyteboat/base": "workspace:*",
    "@lyteboat/distro": "workspace:*",
    "@lyteboat/model-side-call": "workspace:*",
    "@lyteboat/request-context": "workspace:*",
    "@lyteboat/serve": "workspace:*",
    "@lyteboat/testkit": "workspace:*",
    "@lyteboat/tool-policy": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*"
  }
}
