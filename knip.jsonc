// knip runs in `pnpm run lint` with --include unlisted,unresolved,exports,types: every import a package
// makes (src and tests) must resolve through a dependency that package declares, and an
// export or exported type that no other module imports fails. Unused dependencies are not
// checked: lyteboat/apps/cli declares the dsh installation closure the
// launcher resolves rows from, which no source file imports.
{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // The kernel's manifests are upstream's (as npm publishes them) and its tests import
  // through upstream's repository-wide facade; lyteboat does not lint either.
  "ignoreWorkspaces": ["dsh/**"],
  "ignore": ["dsh/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/dist/*.ts", "dsh-compat/tests/*/*.ts"],
      "project": ["scripts/**/*.ts", "dsh-compat/**/*.ts"]
    },
    "lyteboat/apps/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/bundles/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    // Data only: package.json and cordis.patch.yml.
    "lyteboat/bundles/base": {
      "entry": [],
      "project": []
    },
    "lyteboat/plugins/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    // The Studio's pages are an app of their own: studio-main.tsx is the entry Vite builds.
    "lyteboat/plugins/studio-web": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts", "src/client/studio-main.tsx"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    },
    "lyteboat/core/*": {
      "entry": ["tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "examples/agents/*": {
      "entry": ["src/*.ts", "tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "lyteboat/tooling/*": {
      "entry": ["src/*.ts", "tests/**/*.{spec,composite,e2e}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
