{
  "name": "@lyteboat/studio",
  "version": "0.1.0",
  "license": "MIT",
  "description": "lyteboat's Studio workshop bundle over dsh-base and @lyteboat/base: the agents of the --agents directories inspected, and tried in a test window, behind Studio's own sign-in and roles, on /api/studio; `lyteboat studio account` manages the accounts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyteboat/lyteboat.git",
    "directory": "lyteboat/bundles/studio"
  },
  "homepage": "https://github.com/lyteboat/lyteboat#readme",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "@lyteboat/source": "./src/startup.ts",
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/agent-inspector": "workspace:*",
    "@lyteboat/chat-api": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/eval-runner": "workspace:*",
    "@lyteboat/session-index": "workspace:*",
    "@lyteboat/studio-api": "workspace:*",
    "@lyteboat/studio-auth": "workspace:*",
    "@lyteboat/studio-web": "workspace:*",
    "@lyteboat/turn-metrics": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-file-upload": "catalog:dsh",
    "@deepseek-ai/dsh-cmdline": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  },
  "devDependencies": {
    "@lyteboat/agent-definition": "workspace:*",
    "@lyteboat/base": "workspace:*",
    "@lyteboat/serve": "workspace:*",
    "@lyteboat/testkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  },
  "publishConfig": {
    "access": "public"
  }
}
