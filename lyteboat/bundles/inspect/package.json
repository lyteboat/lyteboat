{
  "name": "@lyteboat/inspect",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's inspect bundle over dsh-base: mount one agent the way the business modes do and print what it is made of (its tools and how each reaches the model, its skills and their checks, its eval case files), or why it did not mount",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "@lyteboat/source": "./src/startup.ts",
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/agent-inspector": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/eval-runner": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-cmdline": "catalog:dsh",
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  },
  "devDependencies": {
    "@lyteboat/agent-def": "workspace:*",
    "@lyteboat/host": "workspace:*",
    "@lyteboat/business-base": "workspace:*",
    "@lyteboat/testing": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis"
  }
}
