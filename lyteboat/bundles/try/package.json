{
  "name": "@lyteboat/try",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's one-shot bundle over dsh-base: answer one task, optionally as one of the agents of the --agents directories, and exit",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "@lyteboat/source": "./src/startup.ts",
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lyteboat/a2ui": "workspace:*",
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/history-import": "workspace:*",
    "@lyteboat/intake-guard": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-brand": "catalog:dsh",
    "@deepseek-ai/dsh-cmdline": "catalog:dsh",
    "@deepseek-ai/dsh-session-query": "catalog:dsh",
    "@deepseek-ai/dsh-util-values": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@lyteboat/host": "workspace:*",
    "@lyteboat/business-base": "workspace:*",
    "@lyteboat/testing": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-default-model": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-mock-server": "catalog:dsh",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
