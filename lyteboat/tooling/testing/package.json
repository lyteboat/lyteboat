{
  "name": "@lyteboat/testing",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's test harness: the unit host (dsh's invariants, the dsh services, the kernel's agent loop) and the in-process MockAdapter for unit tests, in-process composition boots for bundle and agent tests, per-file scratch homes and workspaces, the session-log reader and its reopen check, the scripted DeepSeek Messages model, a /chat client, and launcher spawning for e2e tests",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-log": {
      "@lyteboat/source": "./src/session-log.ts",
      "types": "./lib/session-log.d.ts",
      "default": "./lib/session-log.js"
    },
    "./session-reopen": {
      "@lyteboat/source": "./src/session-reopen.ts",
      "types": "./lib/session-reopen.d.ts",
      "default": "./lib/session-reopen.js"
    },
    "./scripted-model": {
      "@lyteboat/source": "./src/scripted-model.ts",
      "types": "./lib/scripted-model.d.ts",
      "default": "./lib/scripted-model.js"
    },
    "./process": {
      "@lyteboat/source": "./src/process.ts",
      "types": "./lib/process.d.ts",
      "default": "./lib/process.js"
    },
    "./composition": {
      "@lyteboat/source": "./src/composition.ts",
      "types": "./lib/composition.d.ts",
      "default": "./lib/composition.js"
    },
    "./chat-client": {
      "@lyteboat/source": "./src/chat-client.ts",
      "types": "./lib/chat-client.d.ts",
      "default": "./lib/chat-client.js"
    },
    "./scratch": {
      "@lyteboat/source": "./src/scratch.ts",
      "types": "./lib/scratch.d.ts",
      "default": "./lib/scratch.js"
    },
    "./json-lines": {
      "@lyteboat/source": "./src/json-lines.ts",
      "types": "./lib/json-lines.d.ts",
      "default": "./lib/json-lines.js"
    }
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@lyteboat/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-include": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-include": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "catalog:dsh",
    "@deepseek-ai/dsh-cmdline": "catalog:dsh",
    "@deepseek-ai/dsh-invariants": "catalog:dsh",
    "@deepseek-ai/dsh-launch-environment": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
