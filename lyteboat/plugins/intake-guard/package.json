{
  "name": "@lyteboat/intake-guard",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's admission ahead of the loop: an agent registers an admission function, a caller submits each request through the service, which admits it and follows it up with the verdict recorded on the request; the loop replies from a recorded reply verdict without a model request, and admits in the loop what arrives unadmitted",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/request-context": "workspace:*",
    "@deepseek-ai/dsh-scope": "catalog:dsh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "devDependencies": {
    "@lyteboat/distro": "workspace:*",
    "@lyteboat/testkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  }
}
