{
  "name": "@lyteboat/eval-runner",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "lyteboat's eval runner: an agent's cases, each a new session whose turns go through dsh's session controller, checked turn by turn from the session log, recorded in a real run and replayed without a model or a key; ./records reads the runs on disk and the case files for the Studio",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./records": {
      "@lyteboat/source": "./src/records.ts",
      "types": "./lib/records.d.ts",
      "default": "./lib/records.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@lyteboat/a2ui": "workspace:*",
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/request-context": "workspace:*",
    "@deepseek-ai/dsh-brand": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-llm-replay": "catalog:dsh",
    "@deepseek-ai/dsh-session-format-catalog": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-compaction": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@lyteboat/testkit": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-compaction": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@types/js-yaml": "catalog:"
  }
}
