{
  "name": "@lyteboat/studio-api",
  "version": "0.1.0",
  "license": "MIT",
  "description": "lyteboat Studio's HTTP API under /api/studio on the host web server: the Host allowlist and security headers, sign-in, role checks, users, the system page, and the agent radar, with an audit log of every change",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyteboat/lyteboat.git",
    "directory": "lyteboat/plugins/studio-api"
  },
  "homepage": "https://github.com/lyteboat/lyteboat#readme",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/agent-inspector": "workspace:*",
    "@lyteboat/chat-api": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/eval-runner": "workspace:*",
    "@lyteboat/session-index": "workspace:*",
    "@lyteboat/studio-auth": "workspace:*",
    "@lyteboat/turn-metrics": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@lyteboat/distro": "workspace:*",
    "@lyteboat/model-side-call": "workspace:*",
    "@lyteboat/skill-router": "workspace:*",
    "@lyteboat/testkit": "workspace:*",
    "@lyteboat/tool-policy": "workspace:*",
    "@lyteboat/turn-outcome": "workspace:*",
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/cordis-plugin-loader": "catalog:cordis",
    "@deepseek-ai/dsh-agent-default-model": "catalog:dsh",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@types/js-yaml": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
