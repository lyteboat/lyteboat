{
  "name": "@lyteboat/chat-api",
  "version": "0.1.0",
  "license": "MIT",
  "description": "lyteboat's /chat endpoint on the host web server: a caller's message reaches an agent through dsh's session controller with its request on the source, after the history it brings is queued as turns of their own, and the answer returns as JSON or an enterprise event stream with cards placed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyteboat/lyteboat.git",
    "directory": "lyteboat/plugins/chat-api"
  },
  "homepage": "https://github.com/lyteboat/lyteboat#readme",
  "type": "module",
  "exports": {
    ".": {
      "@lyteboat/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "dependencies": {
    "@lyteboat/a2ui": "workspace:*",
    "@lyteboat/agent-catalog": "workspace:*",
    "@lyteboat/contracts": "workspace:*",
    "@lyteboat/history-import": "workspace:*",
    "@lyteboat/request-context": "workspace:*",
    "@lyteboat/turn-outcome": "workspace:*",
    "@deepseek-ai/dsh-brand": "catalog:dsh",
    "@deepseek-ai/dsh-credentials": "catalog:dsh",
    "@deepseek-ai/dsh-scope": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:cordis",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
